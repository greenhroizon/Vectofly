{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" } ] },
    { "source": "/img/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/(css|js)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
    { "source": "/site.webmanifest", "headers": [ { "key": "Content-Type", "value": "application/manifest+json" } ] }
  ]
}
